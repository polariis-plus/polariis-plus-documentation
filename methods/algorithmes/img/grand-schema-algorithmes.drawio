=6;" vertex="1" parent="1"><mxGeometry x="500" y="2009" width="300" height="42" as="geometry"/></mxCell><mxCell id="c116" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeColor=#B0503F;strokeWidth=1.3;fontSize=10;fontColor=#B0503F;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="2030" as="sourcePoint"/><mxPoint x="500" y="2030" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c117" value="non" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10.5;fontColor=#B0503F;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="410" y="2014" width="40" height="14" as="geometry"/></mxCell><mxCell id="c118" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeColor=#8A8D98;strokeWidth=1.3;fontSize=10;fontColor=#8A8D98;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="2066" as="sourcePoint"/><mxPoint x="250" y="2096" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c119" value="oui" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10.5;fontColor=#8A8D98;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="256" y="2074.0" width="40" height="14" as="geometry"/></mxCell><mxCell id="c120" value="&lt;b&gt;kNN avec k = 1&lt;/b&gt; : prendre le candidat au plus haut score de ressemblance Q_repr (de 0 à 1), parmi tout ce qui est autorisé" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#2B4570;strokeWidth=1.2;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1C1E26;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=left;verticalAlign=middle;spacingLeft=38;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="60" y="2096" width="380" height="70" as="geometry"/></mxCell><mxCell id="c121" value="3" style="ellipse;fillColor=#1C1E26;strokeColor=#1C1E26;strokeWidth=1;html=1;whiteSpace=wrap;fontSize=11;fontColor=#FFFFFF;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="69" y="2120.0" width="22" height="22" as="geometry"/></mxCell><mxCell id="c122" value="&lt;b&gt;3a · c&#x27;est une activité qui existe déjà :&lt;/b&gt; se brancher dessus. ⚑ provider proxy" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#F3E0DB;strokeColor=#B0503F;strokeWidth=1.2;html=1;whiteSpace=wrap;fontSize=11.5;fontColor=#6E2F22;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="500" y="2088" width="300" height="40" as="geometry"/></mxCell><mxCell id="c123" value="&lt;b&gt;3b · c&#x27;est une gen :&lt;/b&gt; créer une activité, puis la spécifier → &lt;b&gt;B&lt;/b&gt;. ⚑ provider proxy &lt;span style=&#x27;color:#6E4E1F&#x27;&gt;⚙ mode de création&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#F3E0DB;strokeColor=#B0503F;strokeWidth=1.2;html=1;whiteSpace=wrap;fontSize=11.5;fontColor=#6E2F22;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="500" y="2136" width="300" height="46" as="geometry"/></mxCell><mxCell id="c124" value="" style="edgeStyle=none;html=1;rounded=1;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeColor=#B0503F;strokeWidth=1.2;fontSize=10;fontColor=#B0503F;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="2126" as="sourcePoint"/><mxPoint x="500" y="2108" as="targetPoint"/><Array as="points"><mxPoint x="470" y="2126"/><mxPoint x="470" y="2108"/></Array></mxGeometry></mxCell><mxCell id="c125" value="" style="edgeStyle=none;html=1;rounded=1;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeColor=#B0503F;strokeWidth=1.2;fontSize=10;fontColor=#B0503F;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="2126" as="sourcePoint"/><mxPoint x="500" y="2159" as="targetPoint"/><Array as="points"><mxPoint x="470" y="2159"/></Array></mxGeometry></mxCell><mxCell id="c126" value="Un input finit donc &lt;b style=&#x27;color:#1F7A6C&#x27;&gt;branché&lt;/b&gt; sur une activité existante, &lt;b style=&#x27;color:#2B4570&#x27;&gt;relié à une nouvelle activité&lt;/b&gt; à spécifier en B, ou &lt;b style=&#x27;color:#B0503F&#x27;&gt;sans provider&lt;/b&gt; (⚑)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#1C1E26;fontStyle=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="2206" width="740" height="40" as="geometry"/></mxCell><mxCell id="c127" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#FFFBEF;strokeColor=#C9B88E;strokeWidth=1;dashed=1;dashPattern=5 3;" vertex="1" parent="1"><mxGeometry x="850" y="1644" width="360" height="172" as="geometry"/></mxCell><mxCell id="c128" value="EXEMPLE · le jus d&#x27;orange" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontColor=#8A7442;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="862" y="1652" width="336" height="14" as="geometry"/></mxCell><mxCell id="c129" value="Input à connecter : l&#x27;UF, &lt;b&gt;1 kg de jus d&#x27;orange du Québec&lt;/b&gt;.&lt;br&gt;Target : action [FoodProcessing = Pressing] ; output [FoodProduct = Orange] × [FoodForm = Juice] × [Location = CA-QC].&lt;br&gt;&lt;br&gt;Étape 0 : la librairie est vide, rien.&lt;br&gt;Étape 1 : la gen+ « presser des oranges » peut donner exactement ce target → on crée l&#x27;activité « presser des oranges au Québec », et on la spécifie en B." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11.5;fontColor=#3D3B33;fontStyle=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="862" y="1670" width="336" height="140" as="geometry"/></mxCell><mxCell id="c130" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#FFFBEF;strokeColor=#C9B88E;strokeWidth=1;dashed=1;dashPattern=5 3;" vertex="1" parent="1"><mxGeometry x="850" y="1834" width="360" height="112" as="geometry"/></mxCell><mxCell id="c131" value="EXEMPLE · plus haut dans la chaîne" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontColor=#8A7442;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="862" y="1842" width="336" height="14" as="geometry"/></mxCell><mxCell id="c132" value="Plus tard, pour l&#x27;input « électricité du Québec » : étapes 0 et 1, rien ; étape 2, si une base du background a exactement cette électricité, on se branche dessus et on s&#x27;arrête là." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11.5;fontColor=#3D3B33;fontStyle=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="862" y="1860" width="336" height="80" as="geometry"/></mxCell><mxCell id="c133" value="" style="rounded=1;absoluteArcSize=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#2B4570;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="40" y="2282" width="780" height="300" as="geometry"/></mxCell><mxCell id="c134" value="B" style="ellipse;fillColor=#2B4570;strokeColor=#2B4570;strokeWidth=1;html=1;whiteSpace=wrap;fontSize=11;fontColor=#FFFFFF;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="54" y="2296" width="26" height="26" as="geometry"/></mxCell><mxCell id="c135" value="B · SPÉCIFIER LA NOUVELLE ACTIVITÉ" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=14.5;fontColor=#1B2E4B;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="90" y="2296" width="600" height="26" as="geometry"/></mxCell><mxCell id="c136" value="Elle vient d&#x27;une gen : certaines de ses clauses sont encore ouvertes. Il faut toutes les fermer — flux, action, contexte." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#565A66;fontStyle=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="90" y="2322" width="710" height="34" as="geometry"/></mxCell><mxCell id="c137" value="principe" style="rounded=1;absoluteArcSize=1;arcSize=18;fillColor=#FFF3D6;strokeColor=#B8863B;strokeWidth=1;html=1;whiteSpace=wrap;fontSize=10;fontColor=#6E4E1F;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=1;" vertex="1" parent="1"><mxGeometry x="648" y="2298" width="66" height="18" as="geometry"/></mxCell><mxCell id="c138" value="étape 5" style="rounded=1;absoluteArcSize=1;arcSize=18;fillColor=#F3E0DB;strokeColor=#B0503F;strokeWidth=1;html=1;whiteSpace=wrap;fontSize=10;fontColor=#6E2F22;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=1;" vertex="1" parent="1"><mxGeometry x="720" y="2298" width="60" height="18" as="geometry"/></mxCell><mxCell id="c139" value="&lt;b&gt;1 · L&#x27;output reçoit le target&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;font-weight:normal;color:#565A66&quot;&gt;ses clauses prennent les modalités du target : [Location = CA-QC]&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#2B4570;strokeWidth=1.1;html=1;whiteSpace=wrap;fontSize=11.5;fontColor=#1C1E26;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60.0" y="2368" width="136.8" height="128" as="geometry"/></mxCell><mxCell id="c140" value="&lt;b&gt;2 · Contraintes de clauses&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;font-weight:normal;color:#565A66&quot;&gt;le modélisateur a écrit « même Location pour l&#x27;électricité et le jus » : on recopie CA-QC&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#2B4570;strokeWidth=1.1;html=1;whiteSpace=wrap;fontSize=11.5;fontColor=#1C1E26;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="210.8" y="2368" width="136.8" height="128" as="geometry"/></mxCell><mxCell id="c141" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeColor=#2B4570;strokeWidth=1.3;fontSize=10;fontColor=#2B4570;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="196.8" y="2432" as="sourcePoint"/><mxPoint x="210.8" y="2432" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c142" value="&lt;b&gt;3 · Implications&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;font-weight:normal;color:#565A66&quot;&gt;on déduit le contexte : [Location = CA-QC] ⇒ [Climate = Humid continental]. Jamais dans les flux&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#2B4570;strokeWidth=1.1;html=1;whiteSpace=wrap;fontSize=11.5;fontColor=#1C1E26;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="361.6" y="2368" width="136.8" height="128" as="geometry"/></mxCell><mxCell id="c143" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeColor=#2B4570;strokeWidth=1.3;fontSize=10;fontColor=#2B4570;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="347.6" y="2432" as="sourcePoint"/><mxPoint x="361.6" y="2432" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c144" value="&lt;b&gt;4 · Transmettre aux matières&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;font-weight:normal;color:#565A66&quot;&gt;💡 ce que l&#x27;action ne change pas passe aux inputs qui entrent dans le produit : compote bio ⇒ pommes bio, pas électricité bio&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#2B4570;strokeWidth=1.1;html=1;whiteSpace=wrap;fontSize=11.5;fontColor=#1C1E26;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="512.4000000000001" y="2368" width="136.8" height="128" as="geometry"/></mxCell><mxCell id="c145" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeColor=#2B4570;strokeWidth=1.3;fontSize=10;fontColor=#2B4570;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="498.4000000000001" y="2432" as="sourcePoint"/><mxPoint x="512.4000000000001" y="2432" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c146" value="&lt;b&gt;5 · Une clause reste ouverte ?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;font-weight:normal;color:#6E2F22&quot;&gt;⚙ une règle doit choisir (par les données ? par ce qui existe ?). Pas encore décidée&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#F3E0DB;strokeColor=#B0503F;strokeWidth=1.1;html=1;whiteSpace=wrap;fontSize=11.5;fontColor=#6E2F22;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="663.2" y="2368" width="136.8" height="128" as="geometry"/></mxCell><mxCell id="c147" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeColor=#2B4570;strokeWidth=1.3;fontSize=10;fontColor=#2B4570;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="649.2" y="2432" as="sourcePoint"/><mxPoint x="663.2" y="2432" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c148" value="à tester" style="rounded=1;absoluteArcSize=1;arcSize=18;fillColor=#EAE3F1;strokeColor=#6D4A8C;strokeWidth=1;html=1;whiteSpace=wrap;fontSize=10;fontColor=#3E2957;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=1;" vertex="1" parent="1"><mxGeometry x="577.2" y="2359" width="62" height="18" as="geometry"/></mxCell><mxCell id="c149" value="&lt;b&gt;L&#x27;activité est spécifiée&lt;/b&gt; et entre dans la librairie. &lt;b&gt;Ses inputs, maintenant spécifiés, vont dans la file&lt;/b&gt; → on recommence en haut pour chacun." style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#2B4570;strokeColor=#2B4570;strokeWidth=1.2;html=1;whiteSpace=wrap;fontSize=11.5;fontColor=#FFFFFF;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="2516" width="740" height="46" as="geometry"/></mxCell><mxCell id="c150" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#FFFBEF;strokeColor=#C9B88E;strokeWidth=1;dashed=1;dashPattern=5 3;" vertex="1" parent="1"><mxGeometry x="850" y="2282" width="360" height="200" as="geometry"/></mxCell><mxCell id="c151" value="EXEMPLE · le jus d&#x27;orange" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontColor=#8A7442;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="862" y="2290" width="336" height="14" as="geometry"/></mxCell><mxCell id="c152" value="1 · Output : [Location = CA-QC] (FoodProduct = Orange était déjà fixé par la gen+).&lt;br&gt;2 · « Même Location » : l&#x27;électricité et l&#x27;eau passent à CA-QC.&lt;br&gt;3 · Contexte : [Climate = Humid continental].&lt;br&gt;4 · Les oranges : la gen+ a déjà fixé [Location = MX].&lt;br&gt;5 · Plus aucune clause ouverte.&lt;br&gt;&lt;br&gt;Nouveaux inputs dans la file : &lt;b&gt;oranges du Mexique, électricité du Québec, eau du Québec&lt;/b&gt;." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11.5;fontColor=#3D3B33;fontStyle=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="862" y="2308" width="336" height="168" as="geometry"/></mxCell><mxCell id="c153" value="" style="edgeStyle=none;html=1;rounded=1;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeColor=#2B4570;strokeWidth=1.3;fontSize=10;fontColor=#2B4570;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="1850.0" as="sourcePoint"/><mxPoint x="812" y="2282" as="targetPoint"/><Array as="points"><mxPoint x="812" y="1850.0"/></Array></mxGeometry></mxCell><mxCell id="c154" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=none;endFill=1;endSize=6;startArrow=none;strokeColor=#2B4570;strokeWidth=1.3;fontSize=10;fontColor=#2B4570;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="2159" as="sourcePoint"/><mxPoint x="812" y="2159" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c155" value="" style="edgeStyle=none;html=1;rounded=1;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeColor=#2B4570;strokeWidth=1.4;fontSize=10;fontColor=#2B4570;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;labelBackgroundColor=none;dashed=1;dashPattern=4 3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="2539" as="sourcePoint"/><mxPoint x="50" y="1589" as="targetPoint"/><Array as="points"><mxPoint x="28" y="2539"/><mxPoint x="28" y="1589"/></Array></mxGeometry></mxCell><mxCell id="c156" value="" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=1;fontColor=#1C1E26;fontStyle=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="26" y="1644" width="16" height="120" as="geometry"/></mxCell><mxCell id="c157" value="Quand &lt;b&gt;chacun des inputs&lt;/b&gt; d&#x27;une activité a un provider (branché, ou nouvelle activité), l&#x27;activité est &lt;b&gt;connectée&lt;/b&gt;. File vide : toute la structure de la librairie existe." style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#DCE4EF;strokeColor=#2B4570;strokeWidth=1.2;html=1;whiteSpace=wrap;fontSize=11.5;fontColor=#1B2E4B;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="2604" width="780" height="44" as="geometry"/></mxCell><mxCell id="c158" value="" style="rounded=1;absoluteArcSize=1;arcSize=22;fillColor=none;strokeColor=#2B4570;strokeWidth=1;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="12" y="1484" width="1216" height="1184" as="geometry"/></mxCell><mxCell id="c159" value="PARTIE 1 · CONNECTER : trouver un provider pour chaque input, en remontant la chaîne" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=14;fontColor=#1B2E4B;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="1502" width="900" height="22" as="geometry"/></mxCell><mxCell id="c160" value="C&#x27;est ici que se construit la structure : quelles activités existent, et qui fournit qui." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#1B2E4B;fontStyle=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="1526" width="900" height="18" as="geometry"/></mxCell><mxCell id="c161" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeColor=#2B4570;strokeWidth=1.8;fontSize=10;fontColor=#2B4570;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520.0" y="2668" as="sourcePoint"/><mxPoint x="520.0" y="2714" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c162" value="activité connectée" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=12;fontColor=#1B2E4B;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="532.0" y="2682" width="400" height="18" as="geometry"/></mxCell><mxCell id="c163" value="" style="rounded=1;absoluteArcSize=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#1F7A6C;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="40" y="2788" width="780" height="200" as="geometry"/></mxCell><mxCell id="c164" value="C" style="ellipse;fillColor=#1F7A6C;strokeColor=#1F7A6C;strokeWidth=1;html=1;whiteSpace=wrap;fontSize=11;fontColor=#FFFFFF;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="54" y="2802" width="26" height="26" as="geometry"/></mxCell><mxCell id="c165" value="C · CHOISIR L&#x27;UNITÉ DE CHAQUE PARAMÈTRE (les Mesures)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=14.5;fontColor=#124238;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="90" y="2802" width="600" height="26" as="geometry"/></mxCell><mxCell id="c166" value="Un même paramètre peut exister en plusieurs unités. On choisit pour toute l&#x27;activité d&#x27;un coup, parce qu&#x27;un flux peut servir à en calculer un autre." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#565A66;fontStyle=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="90" y="2828" width="710" height="36" as="geometry"/></mxCell><mxCell id="c167" value="acté 02/11" style="rounded=1;absoluteArcSize=1;arcSize=18;fillColor=#DCEEEA;strokeColor=#1F7A6C;strokeWidth=1;html=1;whiteSpace=wrap;fontSize=10;fontColor=#124238;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=1;" vertex="1" parent="1"><mxGeometry x="724" y="2804" width="76" height="18" as="geometry"/></mxCell><mxCell id="c168" value="&lt;b&gt;Lister les combinaisons d&#x27;unités possibles&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#1F7A6C;strokeWidth=1.1;html=1;whiteSpace=wrap;fontSize=11.5;fontColor=#1C1E26;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="60.0" y="2884" width="152.0" height="62" as="geometry"/></mxCell><mxCell id="c169" value="&lt;b&gt;Garder celles où tous les flux se calculent et se branchent sur leur provider&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#1F7A6C;strokeWidth=1.1;html=1;whiteSpace=wrap;fontSize=11.5;fontColor=#1C1E26;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="226.0" y="2884" width="152.0" height="62" as="geometry"/></mxCell><mxCell id="c170" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeColor=#1F7A6C;strokeWidth=1.3;fontSize=10;fontColor=#1F7A6C;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="212.0" y="2915" as="sourcePoint"/><mxPoint x="226.0" y="2915" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c171" value="&lt;b&gt;Préférer celle qui a le plus de valeurs exactes, paramètres de conversion compris&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#1F7A6C;strokeWidth=1.1;html=1;whiteSpace=wrap;fontSize=11.5;fontColor=#1C1E26;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="392.0" y="2884" width="152.0" height="62" as="geometry"/></mxCell><mxCell id="c172" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeColor=#1F7A6C;strokeWidth=1.3;fontSize=10;fontColor=#1F7A6C;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="378.0" y="2915" as="sourcePoint"/><mxPoint x="392.0" y="2915" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c173" value="&lt;b&gt;À égalité : celle qui évite une conversion&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#1F7A6C;strokeWidth=1.1;html=1;whiteSpace=wrap;fontSize=11.5;fontColor=#1C1E26;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="558.0" y="2884" width="152.0" height="62" as="geometry"/></mxCell><mxCell id="c174" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeColor=#1F7A6C;strokeWidth=1.3;fontSize=10;fontColor=#1F7A6C;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="544.0" y="2915" as="sourcePoint"/><mxPoint x="558.0" y="2915" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c175" value="⚙ règle" style="rounded=1;absoluteArcSize=1;arcSize=30;fillColor=#F3E7D2;strokeColor=#B8863B;strokeWidth=1;html=1;whiteSpace=wrap;fontSize=11;fontColor=#6E4E1F;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="724.0" y="2900" width="76" height="30" as="geometry"/></mxCell><mxCell id="c176" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeColor=#1F7A6C;strokeWidth=1.3;fontSize=10;fontColor=#1F7A6C;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="710.0" y="2915" as="sourcePoint"/><mxPoint x="724.0" y="2915" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c177" value="Les combinaisons écartées sont gardées dans un journal." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontColor=#565A66;fontStyle=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="2956" width="740" height="18" as="geometry"/></mxCell><mxCell id="c178" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#FFFBEF;strokeColor=#C9B88E;strokeWidth=1;dashed=1;dashPattern=5 3;" vertex="1" parent="1"><mxGeometry x="850" y="2778" width="360" height="220" as="geometry"/></mxCell><mxCell id="c179" value="EXEMPLE · un paramètre de conversion" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontColor=#8A7442;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="862" y="2786" width="336" height="14" as="geometry"/></mxCell><mxCell id="c180" value="&lt;b&gt;Fabriquer du beurre.&lt;/b&gt; q(lait) = MILK_INPUT × q(beurre). MILK_INPUT existe en &lt;b&gt;kg de lait / kg de beurre&lt;/b&gt; (aucune valeur exacte) et en &lt;b&gt;kg de matière grasse / kg de beurre&lt;/b&gt; (valeur exacte : 0,86).&lt;br&gt;Le provider de lait compte en kg de lait : la 2&lt;sup&gt;e&lt;/sup&gt; unité demande un &lt;b&gt;paramètre de conversion&lt;/b&gt;, FAT_CONTENT = 0,042 kg de matière grasse / kg de lait (exact).&lt;br&gt;0,86 / 0,042 = &lt;b&gt;20,5 kg de lait&lt;/b&gt;. Deux valeurs exactes contre zéro : on garde la 2&lt;sup&gt;e&lt;/sup&gt;." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11.5;fontColor=#3D3B33;fontStyle=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="862" y="2804" width="336" height="188" as="geometry"/></mxCell><mxCell id="c181" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeColor=#1F7A6C;strokeWidth=1.8;fontSize=10;fontColor=#1F7A6C;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520.0" y="2988" as="sourcePoint"/><mxPoint x="520.0" y="3028" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c182" value="une unité par paramètre" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=12;fontColor=#124238;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="532.0" y="2999" width="400" height="18" as="geometry"/></mxCell><mxCell id="c183" value="" style="rounded=1;absoluteArcSize=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#1F7A6C;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="40" y="3028" width="780" height="634" as="geometry"/></mxCell><mxCell id="c184" value="D" style="ellipse;fillColor=#1F7A6C;strokeColor=#1F7A6C;strokeWidth=1;html=1;whiteSpace=wrap;fontSize=11;fontColor=#FFFFFF;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="54" y="3042" width="26" height="26" as="geometry"/></mxCell><mxCell id="c185" value="D · TROUVER UNE VALEUR POUR CHAQUE PARAMÈTRE" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=14.5;fontColor=#124238;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="90" y="3042" width="600" height="26" as="geometry"/></mxCell><mxCell id="c186" value="On cherche la valeur qui correspond exactement à cette activité : le profil précis de chaque flux relié au paramètre. Ex. électricité [Location = CA-QC] par kg d&#x27;oranges [Location = MX], pour [FoodProcessing = Pressing] au Québec." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#565A66;fontStyle=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="90" y="3068" width="710" height="36" as="geometry"/></mxCell><mxCell id="c187" value="R7 · seuil" style="rounded=1;absoluteArcSize=1;arcSize=18;fillColor=#F3E0DB;strokeColor=#B0503F;strokeWidth=1;html=1;whiteSpace=wrap;fontSize=10;fontColor=#6E2F22;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=1;" vertex="1" parent="1"><mxGeometry x="728" y="3044" width="72" height="18" as="geometry"/></mxCell><mxCell id="c188" value="étapes 0-2-3 · équations" style="rounded=1;absoluteArcSize=1;arcSize=18;fillColor=#DCEEEA;strokeColor=#1F7A6C;strokeWidth=1;html=1;whiteSpace=wrap;fontSize=10;fontColor=#124238;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=1;" vertex="1" parent="1"><mxGeometry x="572" y="3044" width="150" height="18" as="geometry"/></mxCell><mxCell id="c189" value="&lt;b&gt;Une valeur saisie par mon organisation&lt;/b&gt;, exactement pour ce profil ? &lt;span style=&#x27;color:#6E4E1F&#x27;&gt;⚙ priorité à mes données · statuts&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#1F7A6C;strokeWidth=1.2;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1C1E26;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=left;verticalAlign=middle;spacingLeft=38;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="60" y="3124" width="380" height="60" as="geometry"/></mxCell><mxCell id="c190" value="0" style="ellipse;fillColor=#1C1E26;strokeColor=#1C1E26;strokeWidth=1;html=1;whiteSpace=wrap;fontSize=11;fontColor=#FFFFFF;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="69" y="3143.0" width="22" height="22" as="geometry"/></mxCell><mxCell id="c191" value="&lt;b&gt;La prendre.&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#DCEEEA;strokeColor=#1F7A6C;strokeWidth=1.2;html=1;whiteSpace=wrap;fontSize=11.5;fontColor=#124238;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="500" y="3130" width="300" height="48" as="geometry"/></mxCell><mxCell id="c192" value="" style="edgeStyle=none;html=1;rounded=0;