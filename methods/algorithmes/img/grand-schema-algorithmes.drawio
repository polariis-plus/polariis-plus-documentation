<mxfile host="Electron"><diagram name="Algorithmes POLARIIS — vue d'ensemble" id="bp3"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="4614" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Les algorithmes de POLARIIS — vue d&#x27;ensemble" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=24;fontColor=#1C1E26;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1240" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Ce que la machine doit faire, de la saisie d&#x27;une activité jusqu&#x27;aux impacts. État au 2 novembre 2026." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13.5;fontColor=#565A66;fontStyle=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="0" y="36" width="1240" height="20" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=1;absoluteArcSize=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#8A8D98;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="0" y="76" width="1240" height="440" as="geometry"/></mxCell><mxCell id="c5" value="LES MOTS DU SCHÉMA" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=13;fontColor=#8A8D98;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="22" y="90" width="400" height="20" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Activité&lt;/b&gt; — &lt;span style=&#x27;color:#565A66&#x27;&gt;un procédé : presser des oranges, produire de l&#x27;électricité. Elle consomme des &lt;b&gt;inputs&lt;/b&gt; et produit des &lt;b&gt;outputs&lt;/b&gt;.&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11.5;fontColor=#1C1E26;fontStyle=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="122" width="382.6666666666667" height="60" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;UF (unité fonctionnelle)&lt;/b&gt; — &lt;span style=&#x27;color:#565A66&#x27;&gt;ce que l&#x27;utilisateur demande : « 1 kg de jus d&#x27;orange du Québec ». C&#x27;est l&#x27;output de référence de la première activité.&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11.5;fontColor=#1C1E26;fontStyle=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="428.6666666666667" y="122" width="382.6666666666667" height="60" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Profil&lt;/b&gt; — &lt;span style=&#x27;color:#565A66&#x27;&gt;la description d&#x27;un flux ou d&#x27;une action par des clauses : [FoodProduct = Orange] × [FoodForm = Juice] × [Location = CA-QC].&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11.5;fontColor=#1C1E26;fontStyle=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="835.3333333333334" y="122" width="382.6666666666667" height="60" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Clause&lt;/b&gt; — &lt;span style=&#x27;color:#565A66&#x27;&gt;une dimension d&#x27;un profil et sa modalité. &lt;b&gt;Fermée&lt;/b&gt; : [FoodProduct = Orange]. &lt;b&gt;Ouverte&lt;/b&gt; : [FoodProduct &amp;lt; Fruit] (un descendant de Fruit) ou [Location] (n&#x27;importe laquelle).&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11.5;fontColor=#1C1E26;fontStyle=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="186" width="382.6666666666667" height="60" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Gen (activité générique)&lt;/b&gt; — &lt;span style=&#x27;color:#565A66&#x27;&gt;un modèle d&#x27;activité POLARIIS dont des clauses restent ouvertes : « presser un fruit », sans dire lequel ni où.&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11.5;fontColor=#1C1E26;fontStyle=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="428.6666666666667" y="186" width="382.6666666666667" height="60" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Gen+&lt;/b&gt; — &lt;span style=&#x27;color:#565A66&#x27;&gt;une gen que le modélisateur a déjà spécifiée en partie : « presser des oranges ».&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11.5;fontColor=#1C1E26;fontStyle=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="835.3333333333334" y="186" width="382.6666666666667" height="60" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Activité instanciée&lt;/b&gt; — &lt;span style=&#x27;color:#565A66&#x27;&gt;une activité dont toutes les clauses sont fermées et tous les nombres connus : « presser des oranges au Québec ».&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11.5;fontColor=#1C1E26;fontStyle=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="250" width="382.6666666666667" height="60" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Provider&lt;/b&gt; — &lt;span style=&#x27;color:#565A66&#x27;&gt;l&#x27;activité qui produit un input. Le provider du jus d&#x27;orange, c&#x27;est le pressage d&#x27;oranges.&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11.5;fontColor=#1C1E26;fontStyle=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="428.6666666666667" y="250" width="382.6666666666667" height="60" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Target d&#x27;un input&lt;/b&gt; — &lt;span style=&#x27;color:#565A66&#x27;&gt;ce qu&#x27;on cherche pour lui trouver un provider : &lt;b&gt;l&#x27;action voulue&lt;/b&gt; ([FoodProcessing = Pressing]) + &lt;b&gt;le profil de l&#x27;input&lt;/b&gt;.&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11.5;fontColor=#1C1E26;fontStyle=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="835.3333333333334" y="250" width="382.6666666666667" height="60" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Paramètre&lt;/b&gt; — &lt;span style=&#x27;color:#565A66&#x27;&gt;un nombre utilisé dans les équations de flux : rendement, électricité par kg de fruit.&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11.5;fontColor=#1C1E26;fontStyle=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="314" width="382.6666666666667" height="60" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Équation de flux&lt;/b&gt; — &lt;span style=&#x27;color:#565A66&#x27;&gt;calcule la quantité d&#x27;un flux à partir de paramètres et des &lt;b&gt;quantités résolues&lt;/b&gt; d&#x27;autres flux : q(électricité) = ELEC_PRESS × q(oranges).&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11.5;fontColor=#1C1E26;fontStyle=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="428.6666666666667" y="314" width="382.6666666666667" height="60" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Provider proxy&lt;/b&gt; — &lt;span style=&#x27;color:#565A66&#x27;&gt;un provider qui ne correspond pas exactement au target, choisi parce qu&#x27;il est le plus ressemblant. Toujours signalé par un ⚑.&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11.5;fontColor=#1C1E26;fontStyle=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="835.3333333333334" y="314" width="382.6666666666667" height="60" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Proxy de valeur&lt;/b&gt; — &lt;span style=&#x27;color:#565A66&#x27;&gt;une valeur de paramètre estimée à partir de valeurs saisies pour des profils voisins (kNN). Toujours signalée.&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11.5;fontColor=#1C1E26;fontStyle=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="378" width="382.6666666666667" height="60" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Version d&#x27;un paramètre&lt;/b&gt; — &lt;span style=&#x27;color:#565A66&#x27;&gt;ce dont dépend sa valeur : ELEC_PRESS « par kg de fruit, selon le fruit et la presse », ou « par heure de machine ». (ScopeSet)&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11.5;fontColor=#1C1E26;fontStyle=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="428.6666666666667" y="378" width="382.6666666666667" height="60" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Mesure&lt;/b&gt; — &lt;span style=&#x27;color:#565A66&#x27;&gt;l&#x27;unité dans laquelle un paramètre est compté : WATER_USE en L d&#x27;eau par kg de fruit, ou en kg d&#x27;eau par kg de fruit.&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11.5;fontColor=#1C1E26;fontStyle=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="835.3333333333334" y="378" width="382.6666666666667" height="60" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Foreground / background&lt;/b&gt; — &lt;span style=&#x27;color:#565A66&#x27;&gt;foreground : les gen POLARIIS, à spécifier. Background : les bases déjà instanciées (librairies publiées, ecoinvent, BAFU…).&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11.5;fontColor=#1C1E26;fontStyle=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="22.0" y="442" width="382.6666666666667" height="60" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Librairie&lt;/b&gt; — &lt;span style=&#x27;color:#565A66&#x27;&gt;ce que produit un run : toutes les activités instanciées et leurs liens, pour un ensemble d&#x27;UF. Publiée, elle rejoint le background.&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11.5;fontColor=#1C1E26;fontStyle=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="428.6666666666667" y="442" width="382.6666666666667" height="60" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;⚙ règle · ⚑ flag&lt;/b&gt; — &lt;span style=&#x27;color:#565A66&#x27;&gt;⚙ un choix fait par l&#x27;utilisateur avant le run (ex. « ecoinvent avant POLARIIS »). ⚑ un signal pour la relecture, qui ne bloque rien.&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11.5;fontColor=#1C1E26;fontStyle=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="835.3333333333334" y="442" width="382.6666666666667" height="60" as="geometry"/></mxCell><mxCell id="c24" value="CE QUI ENTRE" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=12;fontColor=#8A8D98;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="0" y="546" width="300" height="16" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Les UF demandées&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;font-weight:normal;color:#565A66&quot;&gt;ce que la librairie doit savoir produire, et dans quelle unité&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#1C1E26;strokeWidth=1.3;html=1;whiteSpace=wrap;fontSize=13;fontColor=#1C1E26;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="0.0" y="570" width="236.8" height="78" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Le foreground&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;font-weight:normal;color:#565A66&quot;&gt;les gen et gen+ POLARIIS, avec leurs flux, leurs équations de flux et leurs contraintes&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#1C1E26;strokeWidth=1.3;html=1;whiteSpace=wrap;fontSize=13;fontColor=#1C1E26;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="250.8" y="570" width="236.8" height="78" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Le background&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;font-weight:normal;color:#565A66&quot;&gt;les bases déjà instanciées : librairies POLARIIS publiées, ecoinvent, BAFU, Agribalyse…&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#1C1E26;strokeWidth=1.3;html=1;whiteSpace=wrap;fontSize=13;fontColor=#1C1E26;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="501.6" y="570" width="236.8" height="78" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Les paramètres&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;font-weight:normal;color:#565A66&quot;&gt;leurs versions et leurs Mesures, les valeurs saisies (qui, quand, quel statut), les équations entre paramètres&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#1C1E26;strokeWidth=1.3;html=1;whiteSpace=wrap;fontSize=13;fontColor=#1C1E26;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="752.4000000000001" y="570" width="236.8" height="78" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;L&#x27;ontologie&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;font-weight:normal;color:#565A66&quot;&gt;les dimensions et leurs arbres de modalités (taxonomies), les implications, les grandeurs et leurs unités&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=20;fillColor=#FFFFFF;strokeColor=#1C1E26;strokeWidth=1.3;html=1;whiteSpace=wrap;fontSize=13;fontColor=#1C1E26;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1003.2" y="570" width="236.8" height="78" as="geometry"/></mxCell><mxCell id="c30" value="" style="rounded=1;absoluteArcSize=1;arcSize=28;fillColor=#E8EAEE;strokeColor=#5B6474;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="0" y="676" width="1240" height="220" as="geometry"/></mxCell><mxCell id="c31" value="AVANT LE RUN · QUAND LE MODÉLISATEUR CRÉE UNE GEN OU UNE GEN+" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=17;fontColor=#2E3440;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="22" y="690" width="940" height="24" as="geometry"/></mxCell><mxCell id="c32" value="Le modélisateur écrit ses équations de flux, par exemple q(électricité) = ELEC_PRESS × q(fruit), où q(fruit) est la quantité résolue du flux de fruit. La plateforme vérifie tout de suite ce qui ne dépend pas de la librairie : le run n&#x27;aura pas à le refaire." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#2E3440;fontStyle=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="22" y="718" width="1120" height="36" as="geometry"/></mxCell><mxCell id="c33" value="contrôles d&#x27;instanciabilité" style="rounded=1;absoluteArcSize=1;arcSize=18;fillColor=#EAE3F1;strokeColor=#6D4A8C;strokeWidth=1;html=1;whiteSpace=wrap;fontSize=10;fontColor=#3E2957;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=1;" vertex="1" parent="1"><mxGeometry x="1054" y="692" width="160" height="18" as="geometry"/></mxCell><mxCell id="c34" value="versions et liaisons : 26/10" style="rounded=1;absoluteArcSize=1;arcSize=18;fillColor=#DCEEEA;strokeColor=#1F7A6C;strokeWidth=1;html=1;whiteSpace=wrap;fontSize=10;fontColor=#124238;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=1;" vertex="1" parent="1"><mxGeometry x="878" y="692" width="170" height="18" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;1 · Quelle version du paramètre ?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;font-weight:normal;color:#565A66&quot;&gt;ELEC_PRESS existe peut-être en plusieurs versions (par kg de fruit, par heure de machine). On garde celle qui colle aux flux de l&#x27;activité. S&#x27;il en reste plusieurs, on demande au modélisateur.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#5B6474;strokeWidth=1.1;html=1;whiteSpace=wrap;fontSize=12.5;fontColor=#1C1E26;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="22.0" y="762" width="284.0" height="112" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;2 · Relier le paramètre aux flux&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;font-weight:normal;color:#565A66&quot;&gt;ELEC_PRESS dépend de « l&#x27;électricité » et « du fruit » : on dit quel flux de l&#x27;activité joue chaque rôle. Automatique s&#x27;il n&#x27;y a qu&#x27;un candidat ; ces &lt;b&gt;liaisons&lt;/b&gt; sont toutes enregistrées.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#5B6474;strokeWidth=1.1;html=1;whiteSpace=wrap;fontSize=12.5;fontColor=#1C1E26;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="326.0" y="762" width="284.0" height="112" as="geometry"/></mxCell><mxCell id="c37" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeColor=#5B6474;strokeWidth=1.3;fontSize=10;fontColor=#5B6474;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="306.0" y="818" as="sourcePoint"/><mxPoint x="326.0" y="818" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c38" value="&lt;b&gt;3 · Contrôler&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;font-weight:normal;color:#565A66&quot;&gt;unités cohérentes (on n&#x27;additionne pas des kg et des L), un choix d&#x27;unités ferme toutes les équations, pas de boucle entre les flux, chaque dimension utile existe sur le flux relié (C1 à C16).&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#5B6474;strokeWidth=1.1;html=1;whiteSpace=wrap;fontSize=12.5;fontColor=#1C1E26;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="630.0" y="762" width="284.0" height="112" as="geometry"/></mxCell><mxCell id="c39" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeColor=#5B6474;strokeWidth=1.3;fontSize=10;fontColor=#5B6474;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="610.0" y="818" as="sourcePoint"/><mxPoint x="630.0" y="818" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c40" value="&lt;b&gt;4 · Vérifier que la gen pourra être spécifiée&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;font-weight:normal;color:#565A66&quot;&gt;l&#x27;algorithme saura-t-il fermer ses clauses ouvertes ? Sinon, bloquer ou avertir. Contrôles proposés, aucun n&#x27;est décidé.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#5B6474;strokeWidth=1.1;html=1;whiteSpace=wrap;fontSize=12.5;fontColor=#1C1E26;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="934.0" y="762" width="284.0" height="112" as="geometry"/></mxCell><mxCell id="c41" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeColor=#5B6474;strokeWidth=1.3;fontSize=10;fontColor=#5B6474;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="914.0" y="818" as="sourcePoint"/><mxPoint x="934.0" y="818" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c42" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeColor=#8A8D98;strokeWidth=1.6;fontSize=10;fontColor=#8A8D98;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620.0" y="896" as="sourcePoint"/><mxPoint x="620.0" y="924" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c43" value="" style="rounded=1;absoluteArcSize=1;arcSize=28;fillColor=#F3E7D2;strokeColor=#B8863B;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="0" y="924" width="1240" height="226" as="geometry"/></mxCell><mxCell id="c44" value="①" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontColor=#B8863B;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="18" y="936" width="30" height="30" as="geometry"/></mxCell><mxCell id="c45" value="CADRER LA LIBRAIRIE" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=17;fontColor=#6E4E1F;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="54" y="938" width="940" height="24" as="geometry"/></mxCell><mxCell id="c46" value="L&#x27;utilisateur dit quelles UF il veut, et choisit ses règles ⚙ dans un catalogue. Chaque ⚙ réapparaît plus bas, à l&#x27;endroit où il change le chemin." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#6E4E1F;fontStyle=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="54" y="966" width="1120" height="36" as="geometry"/></mxCell><mxCell id="c47" value="valeurs par défaut à choisir" style="rounded=1;absoluteArcSize=1;arcSize=18;fillColor=#F3E0DB;strokeColor=#B0503F;strokeWidth=1;html=1;whiteSpace=wrap;fontSize=10;fontColor=#6E2F22;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=1;" vertex="1" parent="1"><mxGeometry x="1042" y="940" width="172" height="18" as="geometry"/></mxCell><mxCell id="c48" value="catalogue" style="rounded=1;absoluteArcSize=1;arcSize=18;fillColor=#DCEEEA;strokeColor=#1F7A6C;strokeWidth=1;html=1;whiteSpace=wrap;fontSize=10;fontColor=#124238;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=1;" vertex="1" parent="1"><mxGeometry x="964" y="940" width="72" height="18" as="geometry"/></mxCell><mxCell id="c49" value="A · trouver un provider" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=nowrap;fontSize=12;fontColor=#6E4E1F;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="1006" width="190" height="24" as="geometry"/></mxCell><mxCell id="c50" value="⚙ ordre des bases" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#B8863B;strokeWidth=1;html=1;whiteSpace=wrap;fontSize=11;fontColor=#6E4E1F;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="224" y="1006" width="119.0" height="24" as="geometry"/></mxCell><mxCell id="c51" value="⚙ bases imposées" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#B8863B;strokeWidth=1;html=1;whiteSpace=wrap;fontSize=11;fontColor=#6E4E1F;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="351.0" y="1006" width="112.8" height="24" as="geometry"/></mxCell><mxCell id="c52" value="⚙ provider proxy autorisé ?" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#B8863B;strokeWidth=1;html=1;whiteSpace=wrap;fontSize=11;fontColor=#6E4E1F;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="471.8" y="1006" width="181.0" height="24" as="geometry"/></mxCell><mxCell id="c53" value="⚙ mode de création" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#B8863B;strokeWidth=1;html=1;whiteSpace=wrap;fontSize=11;fontColor=#6E4E1F;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="660.8" y="1006" width="125.2" height="24" as="geometry"/></mxCell><mxCell id="c54" value="⚙ limites de création" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#B8863B;strokeWidth=1;html=1;whiteSpace=wrap;fontSize=11;fontColor=#6E4E1F;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="794.0" y="1006" width="143.8" height="24" as="geometry"/></mxCell><mxCell id="c55" value="B · spécifier une activité" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=nowrap;fontSize=12;fontColor=#6E4E1F;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="1040" width="190" height="24" as="geometry"/></mxCell><mxCell id="c56" value="⚙ fermer une clause que rien ne ferme" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#F3E0DB;strokeColor=#B0503F;strokeWidth=1;html=1;whiteSpace=wrap;fontSize=11;fontColor=#6E2F22;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="224" y="1040" width="243.0" height="24" as="geometry"/></mxCell><mxCell id="c57" value="D · trouver une valeur" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=nowrap;fontSize=12;fontColor=#6E4E1F;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="1074" width="190" height="24" as="geometry"/></mxCell><mxCell id="c58" value="⚙ données autorisées" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#B8863B;strokeWidth=1;html=1;whiteSpace=wrap;fontSize=11;fontColor=#6E4E1F;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="224" y="1074" width="137.60000000000002" height="24" as="geometry"/></mxCell><mxCell id="c59" value="⚙ statuts utilisables" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#B8863B;strokeWidth=1;html=1;whiteSpace=wrap;fontSize=11;fontColor=#6E4E1F;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="369.6" y="1074" width="143.8" height="24" as="geometry"/></mxCell><mxCell id="c60" value="⚙ priorité à mes données" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#B8863B;strokeWidth=1;html=1;whiteSpace=wrap;fontSize=11;fontColor=#6E4E1F;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="521.4000000000001" y="1074" width="162.4" height="24" as="geometry"/></mxCell><mxCell id="c61" value="⚙ que mes données" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#B8863B;strokeWidth=1;html=1;whiteSpace=wrap;fontSize=11;fontColor=#6E4E1F;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="691.8000000000001" y="1074" width="119.0" height="24" as="geometry"/></mxCell><mxCell id="c62" value="⚙ proxy de valeur autorisé ?" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#B8863B;strokeWidth=1;html=1;whiteSpace=wrap;fontSize=11;fontColor=#6E4E1F;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="818.8000000000001" y="1074" width="187.20000000000002" height="24" as="geometry"/></mxCell><mxCell id="c63" value="⚙ équations de paramètre" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#F3E0DB;strokeColor=#B0503F;strokeWidth=1;html=1;whiteSpace=wrap;fontSize=11;fontColor=#6E2F22;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="1014.0000000000001" y="1074" width="162.4" height="24" as="geometry"/></mxCell><mxCell id="c64" value="⚙ priorité valeur / équation" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#B8863B;strokeWidth=1;html=1;whiteSpace=wrap;fontSize=11;fontColor=#6E4E1F;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="1184.4" y="1074" width="187.20000000000002" height="24" as="geometry"/></mxCell><mxCell id="c65" value="C · F" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=nowrap;fontSize=12;fontColor=#6E4E1F;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="20" y="1108" width="190" height="24" as="geometry"/></mxCell><mxCell id="c66" value="⚙ départage des unités" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#B8863B;strokeWidth=1;html=1;whiteSpace=wrap;fontSize=11;fontColor=#6E4E1F;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="224" y="1108" width="150.0" height="24" as="geometry"/></mxCell><mxCell id="c67" value="⚙ méthode d&#x27;allocation" style="rounded=1;absoluteArcSize=1;arcSize=24;fillColor=#FFFFFF;strokeColor=#B8863B;strokeWidth=1;html=1;whiteSpace=wrap;fontSize=11;fontColor=#6E4E1F;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="382.0" y="1108" width="150.0" height="24" as="geometry"/></mxCell><mxCell id="c68" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeColor=#B8863B;strokeWidth=1.6;fontSize=10;fontColor=#B8863B;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620.0" y="1150" as="sourcePoint"/><mxPoint x="620.0" y="1178" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c69" value="" style="rounded=1;absoluteArcSize=1;arcSize=28;fillColor=#F3E7D2;strokeColor=#B8863B;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="0" y="1178" width="1240" height="166" as="geometry"/></mxCell><mxCell id="c70" value="②" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontColor=#B8863B;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="18" y="1190" width="30" height="30" as="geometry"/></mxCell><mxCell id="c71" value="ENTRAÎNER LE MODÈLE" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=17;fontColor=#6E4E1F;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="54" y="1192" width="940" height="24" as="geometry"/></mxCell><mxCell id="c72" value="Régler, sur les données déjà saisies, les poids et seuils qui servent à mesurer la ressemblance (étapes A3 et D3). Pas besoin de lancer de run." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#6E4E1F;fontStyle=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="54" y="1220" width="1120" height="20" as="geometry"/></mxCell><mxCell id="c73" value="acté" style="rounded=1;absoluteArcSize=1;arcSize=18;fillColor=#DCEEEA;strokeColor=#1F7A6C;strokeWidth=1;html=1;whiteSpace=wrap;fontSize=10;fontColor=#124238;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=1;" vertex="1" parent="1"><mxGeometry x="1178.4" y="1194" width="35.6" height="18" as="geometry"/></mxCell><mxCell id="c74" value="&lt;b&gt;Calibrer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;font-weight:normal;color:#565A66&quot;&gt;cacher une valeur connue, essayer de la retrouver avec les autres, garder les réglages qui se trompent le moins&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#B8863B;strokeWidth=1.1;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1C1E26;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="54" y="1250" width="270" height="78" as="geometry"/></mxCell><mxCell id="c75" value="&lt;b&gt;Valider&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;font-weight:normal;color:#565A66&quot;&gt;vérifier ces réglages sur des valeurs mises de côté&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;fillColor=#FFFFFF;strokeColor=#B8863B;strokeWidth=1.1;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1C1E26;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="354" y="1250" width="270" height="78" as="geometry"/></mxCell><mxCell id="c76" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeColor=#B8863B;strokeWidth=1.3;fontSize=10;fontColor=#B8863B;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="324" y="1281" as="sourcePoint"/><mxPoint x="354" y="