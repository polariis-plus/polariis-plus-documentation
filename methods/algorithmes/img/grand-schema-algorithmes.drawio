.5;fontColor=#B0503F;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="410" y="3408" width="40" height="14" as="geometry"/></mxCell><mxCell id="c214" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeColor=#8A8D98;strokeWidth=1.3;fontSize=10;fontColor=#8A8D98;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="3460" as="sourcePoint"/><mxPoint x="250" y="3490" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c215" value="oui" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10.5;fontColor=#8A8D98;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="256" y="3468.0" width="40" height="14" as="geometry"/></mxCell><mxCell id="c216" value="&lt;b&gt;kNN&lt;/b&gt; : moyenne des valeurs saisies voisines, pondérée par leur ressemblance (tous les voisins au-dessus du seuil)" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#1F7A6C;strokeWidth=1.2;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1C1E26;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=left;verticalAlign=middle;spacingLeft=38;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="60" y="3490" width="380" height="64" as="geometry"/></mxCell><mxCell id="c217" value="3" style="ellipse;fillColor=#1C1E26;strokeColor=#1C1E26;strokeWidth=1;html=1;whiteSpace=wrap;fontSize=11;fontColor=#FFFFFF;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="69" y="3511.0" width="22" height="22" as="geometry"/></mxCell><mxCell id="c218" value="&lt;b&gt;La prendre.&lt;/b&gt; ⚑ si les voisins sont loin" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#F3E0DB;strokeColor=#B0503F;strokeWidth=1.2;html=1;whiteSpace=wrap;fontSize=11.5;fontColor=#6E2F22;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="500" y="3484" width="300" height="34" as="geometry"/></mxCell><mxCell id="c219" value="personne d&#x27;assez proche → &lt;b&gt;⚑ valeur à collecter&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#B0503F;strokeColor=#B0503F;strokeWidth=1.2;html=1;whiteSpace=wrap;fontSize=11.5;fontColor=#FFFFFF;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="500" y="3526" width="300" height="34" as="geometry"/></mxCell><mxCell id="c220" value="" style="edgeStyle=none;html=1;rounded=1;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeColor=#1F7A6C;strokeWidth=1.2;fontSize=10;fontColor=#1F7A6C;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="3522" as="sourcePoint"/><mxPoint x="500" y="3501" as="targetPoint"/><Array as="points"><mxPoint x="470" y="3522"/><mxPoint x="470" y="3501"/></Array></mxGeometry></mxCell><mxCell id="c221" value="" style="edgeStyle=none;html=1;rounded=1;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeColor=#B0503F;strokeWidth=1.2;fontSize=10;fontColor=#B0503F;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="3522" as="sourcePoint"/><mxPoint x="500" y="3543" as="targetPoint"/><Array as="points"><mxPoint x="470" y="3543"/></Array></mxGeometry></mxCell><mxCell id="c222" value="&lt;b&gt;Puis corriger les paramètres liés&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;font-weight:normal;color:#565A66&quot;&gt;des parts estimées séparément qui font 105 % sont ramenées à 100 % ; dans un bilan matière, un terme est calculé à partir des autres, jamais estimé.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#1F7A6C;strokeWidth=1.1;html=1;whiteSpace=wrap;fontSize=12;fontColor=#1C1E26;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="3580" width="740" height="62" as="geometry"/></mxCell><mxCell id="c223" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#FFFBEF;strokeColor=#C9B88E;strokeWidth=1;dashed=1;dashPattern=5 3;" vertex="1" parent="1"><mxGeometry x="850" y="3028" width="360" height="230" as="geometry"/></mxCell><mxCell id="c224" value="EXEMPLE · le jus d&#x27;orange" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontColor=#8A7442;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="862" y="3036" width="336" height="14" as="geometry"/></mxCell><mxCell id="c225" value="&lt;b&gt;Rendement&lt;/b&gt; (kg de jus par kg d&#x27;oranges) : la seule valeur saisie vaut pour « le monde », pas pour des oranges du Mexique pressées au Québec. Pas exacte, pas d&#x27;équation → moyenne des voisins : &lt;b&gt;0,45&lt;/b&gt; ⚑.&lt;br&gt;&lt;br&gt;&lt;b&gt;Électricité&lt;/b&gt; : même situation → &lt;b&gt;0,05 kWh/kg&lt;/b&gt;.&lt;br&gt;&lt;b&gt;Eau&lt;/b&gt; : &lt;b&gt;3,5 L/kg&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Leçon : une valeur saisie pour « le monde » n&#x27;est jamais exacte pour un lieu précis. Presque tout passe en proxy de valeur." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11.5;fontColor=#3D3B33;fontStyle=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="862" y="3054" width="336" height="198" as="geometry"/></mxCell><mxCell id="c226" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#FFFBEF;strokeColor=#C9B88E;strokeWidth=1;dashed=1;dashPattern=5 3;" vertex="1" parent="1"><mxGeometry x="850" y="3278" width="360" height="110" as="geometry"/></mxCell><mxCell id="c227" value="EXEMPLE · une équation de paramètre" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontColor=#8A7442;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="862" y="3286" width="336" height="14" as="geometry"/></mxCell><mxCell id="c228" value="Masse de la transmission d&#x27;une voiture = ratio transmission × masse de la voiture. Le ratio est cherché pour [VehicleClass = Car] × [Powertrain = ICE], la masse pour le modèle exact : 0,06 × 1 300 = &lt;b&gt;78 kg&lt;/b&gt;." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11.5;fontColor=#3D3B33;fontStyle=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="862" y="3304" width="336" height="78" as="geometry"/></mxCell><mxCell id="c229" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeColor=#1F7A6C;strokeWidth=1.8;fontSize=10;fontColor=#1F7A6C;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520.0" y="3662" as="sourcePoint"/><mxPoint x="520.0" y="3702" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c230" value="chaque paramètre a un nombre (ou un ⚑)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=12;fontColor=#124238;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="532.0" y="3673" width="400" height="18" as="geometry"/></mxCell><mxCell id="c231" value="" style="rounded=1;absoluteArcSize=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#1F7A6C;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="40" y="3702" width="780" height="190" as="geometry"/></mxCell><mxCell id="c232" value="E" style="ellipse;fillColor=#1F7A6C;strokeColor=#1F7A6C;strokeWidth=1;html=1;whiteSpace=wrap;fontSize=11;fontColor=#FFFFFF;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="54" y="3716" width="26" height="26" as="geometry"/></mxCell><mxCell id="c233" value="E · CALCULER LA QUANTITÉ DE CHAQUE FLUX" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=14.5;fontColor=#124238;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="90" y="3716" width="600" height="26" as="geometry"/></mxCell><mxCell id="c234" value="Plus rien à chercher : de l&#x27;arithmétique. L&#x27;UF vaut 1, puis chaque équation de flux est évaluée dans l&#x27;ordre où les flux dépendent les uns des autres." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#565A66;fontStyle=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="90" y="3742" width="710" height="36" as="geometry"/></mxCell><mxCell id="c235" value="liste des grandeurs" style="rounded=1;absoluteArcSize=1;arcSize=18;fillColor=#F3E0DB;strokeColor=#B0503F;strokeWidth=1;html=1;whiteSpace=wrap;fontSize=10;fontColor=#6E2F22;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=1;" vertex="1" parent="1"><mxGeometry x="678" y="3718" width="122" height="18" as="geometry"/></mxCell><mxCell id="c236" value="acté" style="rounded=1;absoluteArcSize=1;arcSize=18;fillColor=#DCEEEA;strokeColor=#1F7A6C;strokeWidth=1;html=1;whiteSpace=wrap;fontSize=10;fontColor=#124238;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=1;" vertex="1" parent="1"><mxGeometry x="628" y="3718" width="44" height="18" as="geometry"/></mxCell><mxCell id="c237" value="&lt;b&gt;L&#x27;UF vaut 1&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#1F7A6C;strokeWidth=1.1;html=1;whiteSpace=wrap;fontSize=11.5;fontColor=#1C1E26;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="60.0" y="3798" width="174.5" height="58" as="geometry"/></mxCell><mxCell id="c238" value="&lt;b&gt;Évaluer les équations dans l&#x27;ordre des dépendances&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#1F7A6C;strokeWidth=1.1;html=1;whiteSpace=wrap;fontSize=11.5;fontColor=#1C1E26;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="248.5" y="3798" width="174.5" height="58" as="geometry"/></mxCell><mxCell id="c239" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeColor=#1F7A6C;strokeWidth=1.3;fontSize=10;fontColor=#1F7A6C;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="234.5" y="3827" as="sourcePoint"/><mxPoint x="248.5" y="3827" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c240" value="&lt;b&gt;L&#x27;unité de chaque flux se déduit du calcul&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#1F7A6C;strokeWidth=1.1;html=1;whiteSpace=wrap;fontSize=11.5;fontColor=#1C1E26;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="437.0" y="3798" width="174.5" height="58" as="geometry"/></mxCell><mxCell id="c241" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeColor=#1F7A6C;strokeWidth=1.3;fontSize=10;fontColor=#1F7A6C;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="423.0" y="3827" as="sourcePoint"/><mxPoint x="437.0" y="3827" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c242" value="&lt;b&gt;Convertir si le provider compte autrement (densité, PCI…)&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#1F7A6C;strokeWidth=1.1;html=1;whiteSpace=wrap;fontSize=11.5;fontColor=#1C1E26;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="625.5" y="3798" width="174.5" height="58" as="geometry"/></mxCell><mxCell id="c243" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeColor=#1F7A6C;strokeWidth=1.3;fontSize=10;fontColor=#1F7A6C;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="611.5" y="3827" as="sourcePoint"/><mxPoint x="625.5" y="3827" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c244" value="Pas de table de conversion : un convertisseur est un paramètre (acté 04/11). Il manque la liste des grandeurs." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontColor=#B0503F;fontStyle=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="60" y="3864" width="740" height="18" as="geometry"/></mxCell><mxCell id="c245" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#FFFBEF;strokeColor=#C9B88E;strokeWidth=1;dashed=1;dashPattern=5 3;" vertex="1" parent="1"><mxGeometry x="850" y="3702" width="360" height="130" as="geometry"/></mxCell><mxCell id="c246" value="EXEMPLE · le jus d&#x27;orange" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontColor=#8A7442;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="862" y="3710" width="336" height="14" as="geometry"/></mxCell><mxCell id="c247" value="jus = &lt;b&gt;1 kg&lt;/b&gt;&lt;br&gt;oranges = 1 / 0,45 = &lt;b&gt;2,22 kg&lt;/b&gt;&lt;br&gt;électricité = 0,05 × 2,22 = &lt;b&gt;0,11 kWh&lt;/b&gt;&lt;br&gt;eau = 3,5 × 2,22 = &lt;b&gt;7,8 L&lt;/b&gt; (si le provider d&#x27;eau compte en kg : conversion par la densité)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11.5;fontColor=#3D3B33;fontStyle=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="862" y="3728" width="336" height="98" as="geometry"/></mxCell><mxCell id="c248" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeColor=#1F7A6C;strokeWidth=1.8;fontSize=10;fontColor=#1F7A6C;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520.0" y="3892" as="sourcePoint"/><mxPoint x="520.0" y="3932" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c249" value="activité quantifiée" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=12;fontColor=#124238;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="532.0" y="3903" width="400" height="18" as="geometry"/></mxCell><mxCell id="c250" value="" style="rounded=1;absoluteArcSize=1;arcSize=18;fillColor=#FFFFFF;strokeColor=#1F7A6C;strokeWidth=1.3;" vertex="1" parent="1"><mxGeometry x="40" y="3932" width="780" height="150" as="geometry"/></mxCell><mxCell id="c251" value="F" style="ellipse;fillColor=#1F7A6C;strokeColor=#1F7A6C;strokeWidth=1;html=1;whiteSpace=wrap;fontSize=11;fontColor=#FFFFFF;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="54" y="3946" width="26" height="26" as="geometry"/></mxCell><mxCell id="c252" value="F · ALLOUER, si l&#x27;activité a plusieurs produits utiles" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=14.5;fontColor=#124238;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="90" y="3946" width="600" height="26" as="geometry"/></mxCell><mxCell id="c253" value="Répartir ce que l&#x27;activité consomme et émet entre ses coproduits, selon une clé (masse, prix…). Seulement maintenant : la clé a besoin des quantités. Un seul produit : rien à faire." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#565A66;fontStyle=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="90" y="3972" width="710" height="36" as="geometry"/></mxCell><mxCell id="c254" value="moment acté" style="rounded=1;absoluteArcSize=1;arcSize=18;fillColor=#DCEEEA;strokeColor=#1F7A6C;strokeWidth=1;html=1;whiteSpace=wrap;fontSize=10;fontColor=#124238;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=1;" vertex="1" parent="1"><mxGeometry x="714" y="3948" width="86" height="18" as="geometry"/></mxCell><mxCell id="c255" value="&lt;b&gt;clé = quantités des coproduits × paramètres&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#1F7A6C;strokeWidth=1.1;html=1;whiteSpace=wrap;fontSize=11.5;fontColor=#1C1E26;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="60" y="4028" width="330" height="40" as="geometry"/></mxCell><mxCell id="c256" value="⚙ méthode d&#x27;allocation" style="rounded=1;absoluteArcSize=1;arcSize=28;fillColor=#F3E7D2;strokeColor=#B8863B;strokeWidth=1;html=1;whiteSpace=wrap;fontSize=11;fontColor=#6E4E1F;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=2;" vertex="1" parent="1"><mxGeometry x="410" y="4034" width="190" height="28" as="geometry"/></mxCell><mxCell id="c257" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeColor=#1F7A6C;strokeWidth=1.3;fontSize=10;fontColor=#1F7A6C;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390" y="4048" as="sourcePoint"/><mxPoint x="410" y="4048" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c258" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#FFFBEF;strokeColor=#C9B88E;strokeWidth=1;dashed=1;dashPattern=5 3;" vertex="1" parent="1"><mxGeometry x="850" y="3932" width="360" height="90" as="geometry"/></mxCell><mxCell id="c259" value="EXEMPLE · le jus d&#x27;orange" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=10;fontColor=#8A7442;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="862" y="3940" width="336" height="14" as="geometry"/></mxCell><mxCell id="c260" value="Le pressage ne produit que du jus : rien à allouer.&lt;br&gt;Ex. ailleurs : une laiterie qui sort du beurre et du babeurre." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11.5;fontColor=#3D3B33;fontStyle=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="862" y="3958" width="336" height="58" as="geometry"/></mxCell><mxCell id="c261" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeColor=#1F7A6C;strokeWidth=1.8;fontSize=10;fontColor=#1F7A6C;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520.0" y="4082" as="sourcePoint"/><mxPoint x="520.0" y="4122" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c262" value="activité allouée" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=12;fontColor=#124238;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="532.0" y="4093" width="400" height="18" as="geometry"/></mxCell><mxCell id="c263" value="Dans une activité : &lt;b&gt;connecter → choisir les unités → trouver les valeurs → calculer&lt;/b&gt;. Tout connecter d&#x27;abord, ou chiffrer au fur et à mesure : sans importance en MVP." style="rounded=1;absoluteArcSize=1;arcSize=14;fillColor=#DCEEEA;strokeColor=#1F7A6C;strokeWidth=1.2;html=1;whiteSpace=wrap;fontSize=11.5;fontColor=#124238;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="4122" width="780" height="40" as="geometry"/></mxCell><mxCell id="c264" value="" style="rounded=1;absoluteArcSize=1;arcSize=22;fillColor=none;strokeColor=#1F7A6C;strokeWidth=1;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="12" y="2714" width="1216" height="1468" as="geometry"/></mxCell><mxCell id="c265" value="PARTIE 2 · CHIFFRER : mettre des nombres dans chaque activité connectée" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=14;fontColor=#124238;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="2732" width="900" height="22" as="geometry"/></mxCell><mxCell id="c266" value="C, D, E, F se font activité par activité, dès qu&#x27;elle est connectée." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#124238;fontStyle=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="2756" width="900" height="18" as="geometry"/></mxCell><mxCell id="c281" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeColor=#2B4570;strokeWidth=1.8;fontSize=10;fontColor=#2B4570;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620.0" y="4192" as="sourcePoint"/><mxPoint x="620.0" y="4220" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c282" value="" style="rounded=1;absoluteArcSize=1;arcSize=28;fillColor=#EAE3F1;strokeColor=#6D4A8C;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="0" y="4220" width="608.0" height="126" as="geometry"/></mxCell><mxCell id="c283" value="④" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontColor=#6D4A8C;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="18" y="4232" width="30" height="30" as="geometry"/></mxCell><mxCell id="c284" value="VÉRIFIER" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=17;fontColor=#3E2957;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="54" y="4234" width="308.0" height="24" as="geometry"/></mxCell><mxCell id="c285" value="au chaud" style="rounded=1;absoluteArcSize=1;arcSize=18;fillColor=#FFF3D6;strokeColor=#B8863B;strokeWidth=1;html=1;whiteSpace=wrap;fontSize=10;fontColor=#6E4E1F;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=1;" vertex="1" parent="1"><mxGeometry x="518.0" y="4236" width="64" height="18" as="geometry"/></mxCell><mxCell id="c286" value="Une personne relit ce que les ⚑ signalent : provider proxys, activités créées, proxys de valeur les plus éloignés, choix faits par une règle. Elle modélise ou collecte ce qui manque, puis relance : tout le run si la structure change, la partie 2 seulement sinon." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12.5;fontColor=#3E2957;fontStyle=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="54" y="4268" width="534.0" height="96" as="geometry"/></mxCell><mxCell id="c287" value="" style="rounded=1;absoluteArcSize=1;arcSize=28;fillColor=#E8EAEE;strokeColor=#5B6474;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="632.0" y="4220" width="608.0" height="126" as="geometry"/></mxCell><mxCell id="c288" value="⑤" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontColor=#5B6474;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="650.0" y="4232" width="30" height="30" as="geometry"/></mxCell><mxCell id="c289" value="PUBLIER" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=17;fontColor=#2E3440;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="686.0" y="4234" width="308.0" height="24" as="geometry"/></mxCell><mxCell id="c290" value="contenu" style="rounded=1;absoluteArcSize=1;arcSize=18;fillColor=#EAE3F1;strokeColor=#6D4A8C;strokeWidth=1;html=1;whiteSpace=wrap;fontSize=10;fontColor=#3E2957;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=1;" vertex="1" parent="1"><mxGeometry x="1154.0" y="4236" width="60" height="18" as="geometry"/></mxCell><mxCell id="c291" value="acté" style="rounded=1;absoluteArcSize=1;arcSize=18;fillColor=#DCEEEA;strokeColor=#1F7A6C;strokeWidth=1;html=1;whiteSpace=wrap;fontSize=10;fontColor=#124238;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;align=center;verticalAlign=middle;spacing=1;" vertex="1" parent="1"><mxGeometry x="1104.0" y="4236" width="44" height="18" as="geometry"/></mxCell><mxCell id="c292" value="La librairie vérifiée rejoint le background : les runs suivants pourront se brancher dessus (étape A2). Ce qu&#x27;elle contient exactement reste à décider : en MVP, ses activités et un seul provider par input, comme ecoinvent ?" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12.5;fontColor=#2E3440;fontStyle=0;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="686.0" y="4268" width="534.0" height="96" as="geometry"/></mxCell><mxCell id="c293" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeColor=#8A8D98;strokeWidth=1.4;fontSize=10;fontColor=#8A8D98;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="608.0" y="4283.0" as="sourcePoint"/><mxPoint x="632.0" y="4283.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c294" value="" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;endSize=6;startArrow=none;strokeColor=#8A8D98;strokeWidth=1.6;fontSize=10;fontColor=#8A8D98;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;labelBackgroundColor=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="930.0" y="4346" as="sourcePoint"/><mxPoint x="930.0" y="4374" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c295" value="" style="rounded=1;absoluteArcSize=1;arcSize=28;fillColor=#F1EFE8;strokeColor=#7A7668;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="0" y="4374" width="1240" height="140" as="geometry"/></mxCell><mxCell id="c296" value="⑥" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontColor=#7A7668;fontStyle=1;fontFamily=IBM Plex Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DIBM%2BPlex%2BSans;spacing=0;" vertex="1" parent="1"><mxGeometry x="18" y="4386" width="30" height="30" as="geometry"/></mxCell><mxCell id="